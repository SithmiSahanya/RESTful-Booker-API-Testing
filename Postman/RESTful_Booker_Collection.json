                  "});\r",
                  "\r",
                  "const response = pm.response.json();\r",
                  "\r",
                  "pm.test(\"First name is updated\", function () {\r",
                  "    pm.expect(response.firstname).to.eql(\"Alex Updated\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Last name is updated\", function () {\r",
                  "    pm.expect(response.lastname).to.eql(\"Brown Updated\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Total price is updated\", function () {\r",
                  "    pm.expect(response.totalprice).to.eql(3000);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Deposit paid is false\", function () {\r",
                  "    pm.expect(response.depositpaid).to.eql(false);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Additional needs are updated\", function () {\r",
                  "    pm.expect(response.additionalneeds).to.eql(\"Lunch\");\r",
